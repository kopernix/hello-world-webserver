# Configuration template. Copy it and adjust:
#
#   cp env.example .env
#
# Docker Compose reads this file automatically. After editing it you must run
#   docker compose up -d
# because "docker compose restart" restarts the container with the configuration
# already frozen and does NOT read the .env again.

# ---------------------------------------------------------------------------
# Ports published on the HOST (inside the container they are always 80 and 443).
# Use 80 and 443 on a normal server, but binding to a port below 1024 requires
# root. These defaults use high ports so that root is not needed.
# ---------------------------------------------------------------------------

# Host port for HTTP.
HTTP_PORT=8080

# Host port for HTTPS.
HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# The response the server returns.
# ---------------------------------------------------------------------------

# HTTP response code. Accepts any value from 200 to 599, including non-standard
# ones: 200, 204, 301, 400, 403, 404, 418, 429, 444, 499, 500, 503, 599...
# With 204 or 304 the body is ignored by definition of the protocol.
STATUS=200

# Response body. A SINGLE LINE and no double quotes, because it goes inside the
# quotes of the nginx configuration. Careful with the dollar sign too: nginx
# expands it, so it does not reach the client literally. A lone "$" or a quote
# will stop nginx from starting.
# Leaving it empty (BODY=) does not give an empty body: it falls back to
# Hello World.
BODY=Hello World

# ---------------------------------------------------------------------------
# The TLS certificate is not configured here: the whole ./tls directory is
# mounted. Out of the box it holds a GENERIC self-signed certificate (no data
# from any machine), so it only validates the chain if you point at localhost;
# any other host needs curl -k. To use your own, replace tls/cert.pem and
# tls/key.pem and run "docker compose up -d". See ./scripts/gen-cert.sh.
# ---------------------------------------------------------------------------
